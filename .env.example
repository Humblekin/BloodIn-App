# Duplicate this file to .env and fill in your own Supabase project credentials.
# Keep .env private — it is gitignored. Never commit real keys.

EXPO_PUBLIC_SUPABASE_URL=https://your-project-id.supabase.co
EXPO_PUBLIC_SUPABASE_ANON_KEY=your-supabase-anon-key-here

# 'test' = PAYSTACK_SECRET_KEY, 'live' = PAYSTACK_LIVE_KEY (set in Supabase secrets)
EXPO_PUBLIC_PAYSTACK_MODE=test
